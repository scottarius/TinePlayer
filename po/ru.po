# Russian translation for TinePlayer.
#
# UNREVIEWED DRAFT - awaiting a native speaker.
#
# Every string here was written in one pass against the English and has not
# been checked by anyone who reads Russian. Treat it as a starting point, not
# as a translation: the terminology is the part most likely to be wrong, and
# the places to look first are
#
#   - "Tonspur"-equivalents: soundtrack/track/audio track are three different
#     things in this interface and English blurs them.
#   - The Kodi and Jellyfin rows, which use those projects' own vocabulary.
#     Whatever Kodi's own Russian says should win over what is here.
#   - The keyboard and gamepad columns on the shortcut page, which are key
#     caps rather than words in several rows.
#
# Plural-Forms is the standard Russian rule: three forms, and the one for 2-4
# is not the one for 5+.
#
msgid ""
msgstr ""
"Project-Id-Version: TinePlayer\n"
"Report-Msgid-Bugs-To: https://github.com/scottarius/TinePlayer/issues\n"
"PO-Revision-Date: 2026-08-17\n"
"Last-Translator: unreviewed draft\n"
"Language-Team: none yet\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"


