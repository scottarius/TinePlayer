# German translation for TinePlayer.
#
# SEED TRANSLATION, NOT YET REVIEWED BY A NATIVE SPEAKER.
#
# This catalog exists so the machinery has something real to compile: it is
# what proves build.rs, the lookup, the plural rule and the placeholder check
# actually work end to end. Every string in it wants a second pair of eyes
# before a release claims TinePlayer speaks German.
#
# If you are that second pair of eyes: the terms worth arguing about are
# "Tonspur" for a soundtrack and "Ausgabegerat" for an output device, both
# chosen to match what Kodi and Jellyfin already say in German, on the grounds
# that somebody arriving from either should not have to learn a second
# vocabulary.
#
msgid ""
msgstr ""
"Project-Id-Version: TinePlayer\n"
"Report-Msgid-Bugs-To: https://github.com/scottarius/TinePlayer/issues\n"
"POT-Creation-Date: 2026-08-17\n"
"PO-Revision-Date: 2026-08-17\n"
"Last-Translator: unreviewed seed\n"
"Language-Team: none yet\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

