<?xml version="1.0" encoding="utf-8"?>
<!--
  Offers TinePlayer to Kodi as an external player. Written into Kodi's userdata
  directory by TinePlayer itself, under Settings, which puts a real command in
  place of the two placeholders below.

  What that command is depends on how both programs were installed, so there
  are two placeholders rather than one. A build from source is run directly,
  by path. A Flatpak cannot be, because the path inside the sandbox means
  nothing outside it, so it is run as "flatpak run app.tineplayer.TinePlayer".
  And if Kodi is itself a Flatpak, whichever of those it is has to be handed
  to flatpak-spawn --host first, because Kodi would otherwise start the player
  inside its own sandbox - where there is no GTK, and no sight of your files.

  This is the template the application consumes, so it keeps the placeholders
  and the RULES markers it cuts on. examples/playercorefactory.xml says the
  same thing to people rather than to a program, with the settings explained
  and nothing to substitute, and wants changing alongside this one.

  Kodi launches the player, waits for it to exit, then carries on. It passes
  only the file, as {1}, so TinePlayer's own resume position and remembered
  track choices are what apply.

  Without the rules block at the end, Kodi keeps playing videos itself and
  TinePlayer appears under "Play using..." in a video's context menu. With it,
  TinePlayer becomes the default for every video. TinePlayer includes that
  block only when asked to be the default player.
-->
<playercorefactory>
  <players>
    <player name="TinePlayer" type="ExternalPlayer" audio="false" video="true">
      <filename>TINEPLAYER_BINARY</filename>
      <args>TINEPLAYER_LAUNCH"{1}" --fullscreen --kodi</args>
      <!-- Gets Kodi out of the way while the film plays, which matters on a
           television where both are fullscreen. -->
      <hidexbmc>true</hidexbmc>
      <!-- On Windows the player is started through a small script, which would
           otherwise sit on screen as a console window for the whole film.
           Ignored on Linux, where the player is started directly. -->
      <hideconsole>true</hideconsole>
      <!-- Stops Kodi writing its own progress when the player exits, which it
           does knowing only how long the player ran, not where it got to. Past
           this many seconds it marks the video fully watched and drops the
           resume point; the default of 10 threw away the real position after
           any real viewing. Below it Kodi saves nothing at all, which is what
           we want, because TinePlayer reports the actual position and watched
           state itself while playing. Set beyond any possible running time. -->
      <playcountminimumtime>2147483647</playcountminimumtime>
    </player>
  </players>
<!-- RULES START -->
  <rules action="prepend">
    <!-- Video only: music and everything else stay with Kodi's own player. -->
    <rule video="true" player="TinePlayer" />
  </rules>
<!-- RULES END -->
</playercorefactory>
