<?xml version="1.0" encoding="utf-8"?>
<!--
  Offers TinePlayer to Kodi as an external player. Copied into Kodi's userdata
  directory by install-kodi.sh or install-kodi.ps1, which put the real path to
  the executable in place of the placeholder below.

  Kodi launches the player, waits for it to exit, then carries on. It passes
  only the file, as {1}, so TinePlayer's own resume position and remembered
  track choices are what apply.

  Without the rules block at the end, Kodi keeps playing videos itself and
  TinePlayer appears under "Play using..." in a video's context menu. With it,
  TinePlayer becomes the default for every video. The install scripts include
  that block only when asked.
-->
<playercorefactory>
  <players>
    <player name="TinePlayer" type="ExternalPlayer" audio="false" video="true">
      <filename>TINEPLAYER_BINARY</filename>
      <args>"{1}" --fullscreen</args>
      <!-- Gets Kodi out of the way while the film plays, which matters on a
           television where both are fullscreen. -->
      <hidexbmc>true</hidexbmc>
    </player>
  </players>
<!-- RULES START -->
  <rules action="prepend">
    <!-- Video only: music and everything else stay with Kodi's own player. -->
    <rule video="true" player="TinePlayer" />
  </rules>
<!-- RULES END -->
</playercorefactory>
