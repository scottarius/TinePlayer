<?xml version="1.0" encoding="utf-8"?>
<!--
  Offers TinePlayer to Kodi as an external player, fully commented.

  TinePlayer writes this file for you: open Settings and choose Kodi, which is
  the easier route. This copy is for setting it up by hand, or for merging into
  a playercorefactory.xml that already configures other players.

  Put it in Kodi's userdata directory and restart Kodi:

    Linux:    ~/.kodi/userdata/playercorefactory.xml
    Windows:  %APPDATA%\Kodi\userdata\playercorefactory.xml

  Kodi has no interface for any of this, which is why the file is edited by
  hand at all.
-->
<playercorefactory>
  <players>
    <player name="TinePlayer" type="ExternalPlayer" audio="false" video="true">

      <!-- The full path to the player.

           An installed TinePlayer is pointed at directly on every platform:
           TinePlayer.exe on Windows, TinePlayer inside the .app bundle on
           macOS, /usr/bin/tineplayer on Linux.

           A build from source on Windows may need launch-tineplayer-windows.cmd,
           at the top of the source tree, rather than the executable. 

           If Kodi itself is a Flatpak, none of the above is reachable from
           inside its sandbox. Use /usr/bin/flatpak-spawn here, and begin the
           args below with --host and then the path. Kodi also needs
           permission for that; see docs/integrations.md. -->
      <filename>/path/to/TinePlayer</filename>

      <!-- {1} is the video Kodi wants played, and is the only substitution
           Kodi makes here.

           The fullscreen flag suits a television. Drop it to play in a window.

           The kodi flag is what tells TinePlayer that Kodi launched it, rather
           than it being guessed at: it takes the resume position from Kodi's
           library, reports progress back while playing, and leaves choosing
           the video to Kodi. Without it the player still works, but the two
           keep separate ideas of where you are in a film. -->
      <args>"{1}" --fullscreen --kodi</args>

      <!-- Gets Kodi out of the way while the film plays, which matters on a
           television where both are fullscreen. -->
      <hidexbmc>true</hidexbmc>

      <!-- Windows only, and only relevant when filename points at the launcher
           script above: without this its console window sits on screen for the
           whole film. Ignored on Linux. -->
      <hideconsole>true</hideconsole>

      <!-- How long the player must run before Kodi marks the video watched
           itself, deliberately set beyond any possible running time.

           Kodi only knows how long the player ran, not where it got to, so
           when the player exits it just writes a bookmark saying "watched" or
           nothing at all.

           With this value, Kodi doesn't set watch percentage itself and 
           allows TinePlayer to report the correct values, as long as the
           kodi flag was passed as described above. -->
      <playcountminimumtime>2147483647</playcountminimumtime>

    </player>
  </players>

  <!-- Without a rules block, Kodi goes on playing video itself and TinePlayer
       appears under "Play using..." in a video's context menu.

       Uncomment this to send every video to TinePlayer instead. Worth knowing:
       on Kodi 20 and earlier "Play using..." only appears under Videos → Files
       and never in the Movies or TV Shows libraries, so this is the practical
       choice there. -->
  <!--
  <rules action="prepend">
    <rule video="true" player="TinePlayer" />
  </rules>
  -->
</playercorefactory>
